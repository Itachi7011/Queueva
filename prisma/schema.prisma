// ============================================================================
// Queueva — Prisma Schema (PostgreSQL)
// ============================================================================
// Multi-tenant Appointment + Workflow Portal for Local Services.
// One PostgreSQL database, tenant isolation is done at the application layer
// via `tenantId` on every tenant-scoped model (standard "shared DB, shared
// schema" multi-tenancy — free-tier friendly, e.g. Neon / Supabase / Railway
// free Postgres, no per-tenant DB provisioning needed).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN   // Queueva platform admin (manages all tenants)
  OWNER         // Provider/shop owner
  STAFF         // Employee of a shop (e.g. stylist, technician, trainer)
  CLIENT        // End customer who books appointments
}

enum TenantStatus {
  PENDING     // Created, awaiting email verification / setup
  ACTIVE
  SUSPENDED   // e.g. subscription lapsed
  DELETED
}

enum SubscriptionPlan {
  FREE_TRIAL
  BASIC
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELED
  APPOINTMENT_RESCHEDULED
  OTP_VERIFICATION
  PASSWORD_RESET
  PAYMENT_RECEIPT
  WELCOME
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_PROVIDER // sent to console fallback because SendGrid/etc not configured
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

// ----------------------------------------------------------------------------
// Tenant (the "shop" — salon, gym, repair shop, etc.)
// ----------------------------------------------------------------------------

model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique // used in path (/slug) AND subdomain (slug.queueva.com)
  name          String
  description   String?
  logoUrl       String?      // Cloudinary URL
  coverImageUrl String?
  category      String?      // "Salon", "Gym", "Repair Shop", etc.
  phone         String?
  email         String?
  address       String?
  timezone      String       @default("Asia/Kolkata")
  status        TenantStatus @default(PENDING)

  // Working hours, keyed by weekday name -> { open, close, closed }
  businessHours Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  services      Service[]
  appointments  Appointment[]
  notifications Notification[]
  subscription  Subscription?
  payments      Payment[]

  @@index([slug])
  @@map("tenants")
}

// ----------------------------------------------------------------------------
// User (super admin / owner / staff / client) — one table, role-based
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  tenantId     String?  // null for SUPER_ADMIN (platform-level)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  name         String
  email        String
  passwordHash String
  role         UserRole
  phone        String?
  avatarUrl    String?  // Cloudinary URL

  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(true)

  // Staff-only fields
  title        String?   // e.g. "Senior Stylist"
  bio          String?
  specialties  String[]  @default([])

  refreshTokenVersion Int @default(0) // bump to invalidate all refresh tokens

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffAppointments  Appointment[] @relation("StaffAppointments")
  clientAppointments Appointment[] @relation("ClientAppointments")
  notifications      Notification[]
  payments           Payment[]
  otpTokens          OtpToken[]

  // A given email must be unique *within* a tenant (and globally unique for
  // users with no tenant, i.e. super admins) — enforced here at the DB level
  // (Postgres treats each NULL as distinct, so multiple super-admin-style
  // rows with tenantId = NULL and different emails work fine; true global
  // uniqueness for tenantId = NULL emails is additionally enforced in code).
  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

// ----------------------------------------------------------------------------
// Service offered by a tenant (e.g. "Haircut", "60-min Massage", "Oil Change")
// ----------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  name        String
  description String?
  durationMin Int      // duration in minutes
  priceCents  Int      // stored in smallest currency unit
  currency    String   @default("INR")
  imageUrl    String?  // Cloudinary URL
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

// ----------------------------------------------------------------------------
// Appointment
// ----------------------------------------------------------------------------

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  staffId String?
  staff   User?   @relation("StaffAppointments", fields: [staffId], references: [id])

  clientId String
  client   User   @relation("ClientAppointments", fields: [clientId], references: [id])

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(PENDING)
  notes   String?

  // Recurrence
  recurrence        RecurrenceFrequency @default(NONE)
  recurrenceEndDate DateTime?
  recurrenceGroupId String?              // links all occurrences of one recurring series

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([tenantId, startAt])
  @@index([staffId, startAt])
  @@index([recurrenceGroupId])
  @@map("appointments")
}

// ----------------------------------------------------------------------------
// Notification log (email/SMS) — also used to power the dev console fallback
// ----------------------------------------------------------------------------

model Notification {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  channel NotificationChannel @default(EMAIL)
  type    NotificationType
  status  NotificationStatus  @default(PENDING)

  to      String
  subject String?
  body    String

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// OTP / verification tokens (email verification, password reset, login OTP)
// ----------------------------------------------------------------------------

model OtpToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  codeHash   String    // hashed OTP, never store plaintext
  purpose    String    // "EMAIL_VERIFICATION" | "PASSWORD_RESET" | "LOGIN"
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otp_tokens")
}

// ----------------------------------------------------------------------------
// Subscription (per-tenant SaaS plan) — monetization
// ----------------------------------------------------------------------------

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  plan   SubscriptionPlan   @default(FREE_TRIAL)
  status SubscriptionStatus @default(TRIALING)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// ----------------------------------------------------------------------------
// Payment (Stripe-backed, client portal payments for appointments)
// ----------------------------------------------------------------------------

model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  amountCents Int
  currency    String        @default("INR")
  status      PaymentStatus @default(REQUIRES_PAYMENT)

  stripePaymentIntentId String?
  stripeChargeId        String?
  failureReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([stripePaymentIntentId])
  @@map("payments")
}
